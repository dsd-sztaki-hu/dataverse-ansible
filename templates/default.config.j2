[glassfish]
HOST_DNS_ADDRESS = {{ servername }}
GLASSFISH_USER = {{ dataverse.payara.user }}
GLASSFISH_DIRECTORY = {{ dataverse.payara.root }}/{{ dataverse.payara.dir }}
GLASSFISH_ADMIN_USER = {{ dataverse.payara.adminuser }}
GLASSFISH_ADMIN_PASSWORD = {{ dataverse.payara.adminpass }}
GLASSFISH_HEAP = {{ dataverse.memheap }}
GLASSFISH_REQUEST_TIMEOUT = {{ dataverse.payara.request_timeout }}

[database]
POSTGRES_ONLY = false
POSTGRES_SERVER	= {{ db.postgres.host }}
POSTGRES_PORT = {{ db.postgres.port }}
POSTGRES_DATABASE = {{ db.postgres.name }}
POSTGRES_USER = {{ db.postgres.user }}
POSTGRES_PASSWORD = {{ db.postgres.pass }}
POSTGRES_ADMIN_PASSWORD = {{ db.postgres.adminpass }}

[system]
ADMIN_EMAIL = {{ dataverse.service_email }}
MAIL_SERVER = {{ dataverse.smtp }}
SOLR_LOCATION = LOCAL

[rserve]
RSERVE_HOST = {{ rserve.host }}
RSERVE_PORT = {{ rserve.port }}
RSERVE_USER = {{ rserve.user }}
RSERVE_PASSWORD = {{ rserve.pass }}

[doi]
DOI_USERNAME = {{ dataverse.pid[dataverse.pid.default_provider].datacite.username if dataverse.pid[dataverse.pid.default_provider].datacite is defined else 'x' }}
DOI_PASSWORD = {{ dataverse.pid[dataverse.pid.default_provider].datacite.password if dataverse.pid[dataverse.pid.default_provider].datacite is defined else 'x' }}
DOI_BASEURL = {{ dataverse.pid[dataverse.pid.default_provider].datacite.mds_api_url if dataverse.pid[dataverse.pid.default_provider].datacite is defined else 'https://mds.test.datacite.org/' }}
DOI_MDCBASEURL = {{ dataverse.pid[dataverse.pid.default_provider].datacite.rest_api_url if dataverse.pid[dataverse.pid.default_provider].datacite is defined else 'https://api.test.datacite.org/' }}
DOI_DATACITERESTAPIURL = {{ dataverse.pid[dataverse.pid.default_provider].datacite.rest_api_url if dataverse.pid[dataverse.pid.default_provider].datacite is defined else 'https://api.test.datacite.org' }}
